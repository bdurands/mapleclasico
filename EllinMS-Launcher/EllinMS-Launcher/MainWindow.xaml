<Window x:Class="EllinMS_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EllinMS Launcher"
        Width="850" Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Play button style -->
        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2ECC40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF2ECC40" BlurRadius="18" ShadowDepth="0" Opacity="0.7"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF27AE35"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF2ECC40" BlurRadius="28" ShadowDepth="0" Opacity="1.0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E8A2C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FF555555"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFCC2222"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar style -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#FF2ECC40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root" Margin="0,-15" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Height="6" VerticalAlignment="Center"/>
                            <!-- Indeterminate animation -->
                            <Border x:Name="IndeterminateBar"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    Opacity="0"
                                    Width="120"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF2ECC40" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndeterminateTranslate" X="-120"/>
                                </Border.RenderTransform>
                            </Border>
                            <!-- Determinate fill -->
                            <Border x:Name="PART_Track" CornerRadius="3" Height="6" VerticalAlignment="Center"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF2ECC40" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Opacity" Value="0"/>
                                <Setter TargetName="IndeterminateBar" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="IndeterminateTranslate"
                                                Storyboard.TargetProperty="X"
                                                From="-120" To="750"
                                                Duration="0:0:1.4"
                                                EasingFunction="{x:Null}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer drop shadow border -->
    <Border CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.8"/>
        </Border.Effect>

        <!-- Main rounded container -->
        <Border CornerRadius="14" ClipToBounds="True">
            <Grid>
                <!-- BACKGROUND IMAGE -->
                <Border CornerRadius="14" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush ImageSource="Assets/bg.png" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- Dark gradient overlay on background -->
                <Border CornerRadius="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A000000" Offset="0"/>
                            <GradientStop Color="#88000000" Offset="0.7"/>
                            <GradientStop Color="#EE000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- CONTENT GRID -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>   <!-- Title bar -->
                        <RowDefinition Height="*"/>    <!-- Content area -->
                        <RowDefinition Height="110"/>  <!-- Bottom bar -->
                    </Grid.RowDefinitions>

                    <!-- ===== TITLE BAR ===== -->
                    <Grid Grid.Row="0" Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#FF2ECC40" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FF2ECC40" BlurRadius="8" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="EllinMS Launcher" Foreground="White"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Opacity="0.9"/>
                        </StackPanel>

                        <!-- Close button top-right -->
                        <Button x:Name="btnClose"
                                Content="✕"
                                Style="{StaticResource CloseButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="30" Height="26"
                                Click="BtnClose_Click"/>
                    </Grid>

                    <!-- ===== MIDDLE CONTENT AREA ===== -->
                    <Grid Grid.Row="1">
                        <!-- Subtitle / Tagline bottom-left -->
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="28,0,0,20">
                            <Border Background="#66000000" CornerRadius="6" Padding="10,4">
                                <TextBlock Text="Classic Server"
                                           FontFamily="Segoe UI"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FFE0E0E0"/>
                            </Border>
                        </StackPanel>

                        <!-- Version info bottom-right of content area -->
                        <TextBlock x:Name="lblVersion"
                                   Text="v1.0.0"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="#66FFFFFF"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,20,10"/>
                    </Grid>

                    <!-- ===== BOTTOM BAR ===== -->
                    <Border Grid.Row="2" CornerRadius="0,0,14,14">
                        <Border.Background>
                            <SolidColorBrush Color="#CC0A0A0F"/>
                        </Border.Background>

                        <!-- Top separator line -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Separator -->
                            <Rectangle Grid.Row="0" Fill="#22FFFFFF"/>

                            <!-- Bottom bar content -->
                            <Grid Grid.Row="1" Margin="20,12,20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Status info + progress -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">

                                    <!-- Status row -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="lblStatus"
                                                   Text="Listo. Haz clic en PLAY para iniciar."
                                                   FontFamily="Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock x:Name="lblFileCount"
                                                   Grid.Column="1"
                                                   Text=""
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   Foreground="#FF888888"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Progress bar -->
                                    <ProgressBar x:Name="pbProgress"
                                                 Style="{StaticResource ModernProgressBar}"
                                                 Value="0"
                                                 Minimum="0"
                                                 Maximum="100"/>

                                    <!-- Speed/size info -->
                                    <TextBlock x:Name="lblSpeed"
                                               Text=""
                                               FontFamily="Segoe UI"
                                               FontSize="10"
                                               Foreground="#FFAAAAAA"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Right: Play button -->
                                <Button x:Name="btnPlay"
                                        Grid.Column="1"
                                        Content="PLAY"
                                        Style="{StaticResource PlayButtonStyle}"
                                        Width="140"
                                        Height="58"
                                        Click="BtnPlay_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
